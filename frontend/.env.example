# Copy this file to .env and fill in real values before running the frontend:
#   cp .env.example .env
#
# Vite only exposes variables prefixed with VITE_ to the browser bundle.
# Anything without that prefix stays on the server and is never shipped.
#
# IMPORTANT: this file is TEMPLATE ONLY and Vite never reads it. Vite loads
# .env, .env.local, .env.production and .env.production.local -- not
# .env.example. It exists so the variable name and format are documented.
#
# NOTE: every VITE_* value is baked into the built JavaScript at build time.
# There is no way to change it afterwards without a rebuild, so the value must
# be set in Vercel's environment variables before you deploy -- not in the Vercel
# dashboard after the first build.

# Base URL of the Express API.
#
# Leave this UNSET in development. frontend/vite.config.js then proxies /api to
# http://localhost:5001, so the browser only ever talks to the dev server on
# 5173 and there are no cross-origin requests at all.
#
# Set it in production to the full Render URL, including the /api suffix:
#   VITE_API_URL=https://hazard-hunt-api.onrender.com/api
#
# If you leave it unset in production the built app falls back to the relative
# path /api and will request your own Vercel origin, which returns 404.
VITE_API_URL=