# Copy this file to .env and fill in real values before running the server.

# Local MongoDB:      mongodb://127.0.0.1:27017/hazardhunt
# MongoDB Atlas (free tier): mongodb+srv://<user>:<password>@<cluster>.mongodb.net/hazardhunt
MONGO_URI=mongodb://127.0.0.1:27017/hazardhunt

# Any long random string — used to sign JWTs. Change this before any real deployment.
JWT_SECRET=change_this_to_a_long_random_string_before_deploying

# How long an issued login token stays valid.
JWT_EXPIRES_IN=8h

# Port the Express API listens on.
PORT=5000

# URL of the Vite dev server, for CORS.
CLIENT_ORIGIN=http://localhost:5173
