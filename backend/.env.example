PORT=5000
NODE_ENV=development
# Optional: supply external MongoDB connection string (e.g. mongodb://localhost:27017/hazard_hunt or Atlas URI)
# If left blank, Hazard Hunt automatically runs with an embedded zero-config MongoDB instance.
MONGODB_URI=
# Use a long, random value in any shared or production environment.
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=24h
CLIENT_URL=http://localhost:5173
