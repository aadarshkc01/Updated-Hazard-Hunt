# Copy this file to .env and fill in real values before running the server.
#   cp .env.example .env
#
# The variable names below must match the code exactly. An earlier version of
# this file said MONGO_URI, but the code reads MONGODB_URI. With the wrong name
# the server silently falls back to an in-memory database, so every user record
# disappears on restart.

# ---------------------------------------------------------------------------
# Required in production
# ---------------------------------------------------------------------------

# MongoDB connection string.
#   Local:  mongodb://127.0.0.1:27017/hazardhunt
#   Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/hazardhunt
#
# On a PaaS host this is REQUIRED. When NODE_ENV=production the server refuses to
# boot without it rather than silently using a throwaway in-memory database.
MONGODB_URI=

# Long random string used to sign JWTs. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Never reuse the placeholder below on a deployed instance.
JWT_SECRET=change_this_to_a_long_random_string_before_deploying

# How long an issued login token stays valid.
JWT_EXPIRES_IN=8h

# Browser origins allowed to call this API. Comma-separated.
#
#   Local:  http://localhost:5173
#   Deployed: paste the Vercel URL, e.g.
#     CLIENT_ORIGIN=https://hazard-hunt.vercel.app,https://your-name.vercel.app
#
# This is an allowlist. Anything not listed is rejected, so a preview
# deployment needs adding here too if you want it to work.
CLIENT_ORIGIN=http://localhost:5173

# Which scenario the API serves.
#
# The lookup asks for this specific scenario by code rather than for whichever
# one is flagged active. A shared database can hold several scenarios marked
# active at once, and "first one found" is not a guarantee - that mistake once
# served an older scenario whose hazards were not even in this bay.
SCENARIO_CODE=WH-BAY-04

# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------

# Port the Express API listens on.
#
# Render OVERRIDES this with its own value and routes traffic to it, which is
# the correct behaviour -- do not hardcode a port number. The 5001 default here
# only affects local development, where frontend/vite.config.js proxies /api to
# http://localhost:5001.
PORT=5001

# Set to production on a deployed host. This switches on the strict database
# behaviour described above (fail loudly instead of falling back to in-memory).
# Render sets this for you automatically.
NODE_ENV=development